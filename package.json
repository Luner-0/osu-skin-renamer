{
  "name": "osu-skin-renamer",
  "version": "1.0.0",
  "description": "List and bulk-rename osu!lazer skins directly in the client.realm database",
  "main": "main.js",
  "author": "luner",
  "scripts": {
    "list": "node skin-tool.js list",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.luner.osu-skin-renamer",
    "productName": "osu-skin-renamer",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "skin-tool.js",
      "!node_modules/realm/prebuilds/apple/**",
      "!node_modules/realm/prebuilds/android/**"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "realm": "^12.14.1"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
